/* cards*/

.card{
    background-color: #ffffff;
    border: 3.5px solid #0a2356; /* Borda azul-escuro marcante */
    border-radius: 16px;
    padding: 18px;        
    width: 100%;
    max-width: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow: 0 4px 12px rgba(10, 35, 86, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
            
}


