.body{
    font-family: Arial, Helvetica, sans-serif;
    color: #1d1148;
    background-color: #f7f7f9;
}

.container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 16px;
}

/* Cabeçalho*/
.header{
    background-color: #ffffff;
    width: 100%;
    display: center;
}

.header .container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 16px;
  display: flex;
  justify-content: space-between; /* Empurra o logótipo para a esquerda e os links para a direita */
  align-items: center; /* Alinha ao centro */
}

.logo-pink {
  color: #e40084; /* Cor rosa de destaque */
  /*display: inline;*/
}

/* Estilo do logotipo */
.logo {
  font-size: 24px;
  font-weight: bold;
}

/* Menu com os links */
.menu {
    display: flex;
    gap: 24px;
}

.menu a {
    font-family: Arial, Helvetica, sans-serif;
    text-decoration: none;
    color: #1d1148;
    transition: color 0.2s ease;
}

/* Efeito ao passar o rato por cima dos links */
.menu a:hover {
    color: #e40084;
}

/* --- Destaque (Hero) --- */
.banner {
  background-color: #1d1148;
  color: #ffffff;
  text-align: center;
  padding: 48px 20px;
}

.banner-button {
  background-color: #e40084;
  color: #ffffff;
  padding: 12px 24px;
  border-radius: 50px;
  font-size: 1rem;
  display: inline-block;
  
}

.btn-primary:hover {
  opacity: 0.9;
}

 /* Container Principal (GRID / FLEXBOX RESPONSIVO) */
.cards-container {
   position: relative;
    /* para que os cartões possam ser posicionados relativamente a ele */
    width: 980px;
    height: 300px;
    padding: 400px 20px;
    margin: 0 flex;
    /* centra horizontalmente */
    top: 200px;
}

/* Estilo do cartão*/        
.card{
   box-sizing: border-box;
    /* os 300px já incluem padding e borda */
    width: 300px;
    padding: 16px;
    /* dentro da borda */
    border: 3px solid #1d1148;
    /* a moldura */
    border-radius: 20px;
    /* cantos arredondados */
    background-color: #1d1148;
    text-align: center;
    
    /* Posicionamento dentro do element relative */
    position: absolute;
    top: 0;
            
}

.card1{
   left: 0;
    width: max-content;
    height: max-content;
    font: 100;
    color: #1d1148;
}

.card2 {
    left: 340px;
    /* 300px do 1.º cartão + 40px de espaço */
    font: 100;
    color: #1d1148;
}


.card3 {
    left: 680px;
    /* 2 × 340px */
    font: 100;
    color: #1d1148;
}

